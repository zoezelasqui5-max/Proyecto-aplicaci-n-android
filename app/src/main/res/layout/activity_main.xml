<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agenda de Turnos"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestioná tus turnos de forma simple"
        android:textSize="16sp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnNuevoTurno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agregar turno"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnMisTurnos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis turnos"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnTurnosRecurrentes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reservar varios turnos" />

</LinearLayout>